{
  "permissions": {
    "allow": [
      "Bash(npm run build:hooks-rs:*)",
      "Bash(pnpm --version:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm run typecheck:f:*)",
      "Bash(pnpm run build:f:*)",
      "Bash(pnpm run test:f:*)",
      "Bash(gh repo view:*)",
      "Bash(gh issue create:*)",
      "Bash(gh pr create:*)",
      "Bash(gh api:*)",
      "Bash(gh issue list:*)",
      "Bash(jj status:*)",
      "Bash(jj git init:*)",
      "Bash(jj git fetch:*)",
      "Bash(jj bookmark:*)",
      "Bash(jj log:*)",
      "Bash(jj diff:*)",
      "Bash(jj describe:*)",
      "Bash(jj new:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm run test:coverage:f:*)",
      "Bash(npx vitest run:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm run build:hooks-rs:*)",
      "Bash(cargo test:*)",
      "Bash(jj squash:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"%CLAUDE_PROJECT_DIR%\\.claude\\validate-command.exe\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
