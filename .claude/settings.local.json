{
  "permissions": {
    "allow": [
      "Bash(npm run build:hooks-rs:*)",
      "Bash(pnpm --version:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm run typecheck:f:*)",
      "Bash(pnpm run build:f:*)",
      "Bash(pnpm run test:f:*)",
      "Bash(gh repo view:*)",
      "Bash(git branch:*)",
      "Bash(gh issue create:*)",
      "Bash(git checkout:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"%CLAUDE_PROJECT_DIR%\\.claude\\validate-command.exe\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
